{
    "version": "0.12.1",
    "tasks": {
        // The gate. One command, so there is no version of "I ran the tests but not the build".
        // `build` writes `dist/`, which git does not carry: what ships is checked as a file.
        // Why no browser is asked for here: W9, and ADR 0047. `tests/e2e/` is Playwright's, named
        // `.spec.ts` so `deno test` does not look for it, and `e2e` below is where it runs.
        //
        // ⚠️ `deno check` is named twice, and today the second call is covered by the first.
        // Measured 2026-09-03 on Deno 2.9.6: with no argument it checks every file under the tree
        // minus this file's `exclude` — 159 of them, `playwright.config.ts` and every `.spec.ts`
        // included — and a spec calling a constant nobody declared reddens it. It stays because
        // that is a behaviour of the no-argument form and not a promise it makes: a spec is
        // imported by nothing, so naming the directory is what keeps it checked whatever a later
        // Deno decides the bare command means.
        "check": "deno fmt --check && deno lint && deno check && deno check tests/e2e && deno test -A && deno task build",
        // The same tree in a real browser: the built file, driven in the Chrome this machine has.
        // Kept out of the gate on purpose — ADR 0047 — and run by CI and before a release.
        "e2e": "npx playwright test",
        // The file a reader installs. A release passes its version; a build without one takes
        // what `deno.json` declares and marks it `-dev` — ADR 0035.
        "build": "deno run -A tools/build-userscript.ts",
        // The panel in a browser, changing while you edit it: the add-on over a recording,
        // rebuilt and reloaded on a change under `src/`.
        "preview": "deno run -A tools/preview-server.ts",
        // The same panel, written down for somebody who has installed nothing: one page per
        // recording under `dist/preview`, which `.github/workflows/pages.yml` publishes. That
        // workflow passes `--release`, which is what the published panel states — ADR 0037.
        "preview:site": "deno run -A tools/preview-site.ts",
        // The panel photographed, one picture per state a README shows. It refuses a tree whose
        // `src/` is not in a commit, which is `DESIGN.md`'s rule and not this file's. A release
        // takes the set again with `--release`, and the panel then states the number it ships as.
        "panel:shots": "deno run -A tools/panel-screenshots.ts",
        // Which rows of the panel open onto another level, measured rather than remembered.
        // `docs/drill-levels.md` carries the verdicts; `--cases` states the counts behind them.
        "panel:drill": "deno run -A tools/drill-report.ts",
        // What the decoder could not read, over the corpus or over a recording you name — the
        // question that decides whether an intake is worth starting.
        "fight:decoding": "deno run -A tools/decoding-status.ts",
        // The same material the other way round: what the figures come to, per combatant, as the
        // panel would draw them.
        "fight:figures": "deno run -A tools/fight-figures.ts",
        // How many turns a fight's combatants took, against the game's own numbering of them.
        // `docs/turns-taken.md` carries the verdicts; `--cases` states the counts behind them.
        "fight:turns": "deno run -A tools/turn-count.ts",
        // The same count one step earlier: how a message becomes a turn, and which message a
        // disagreement stands on. `docs/reading-a-turn.md` carries the disputed openers and, with
        // `--keys`, what opened every turn and what each protocol key adds.
        "fight:openers": "deno run -A tools/turn-reading.ts",
        // What a skill put on a whole side, how often it was cast and how many ran at once —
        // against the turns the published table states. `docs/auras-standing.md` carries them.
        "fight:auras": "deno run -A tools/aura-standing.ts",
        // What the payload's own status mask leaves standing, and for how long — against what the
        // published skill table says it should. `docs/statuses-standing.md` carries the verdicts.
        "fight:statuses": "deno run -A tools/status-standing.ts",
        // How a recording the add-on wrote becomes material: two redactions, then a file.
        "capture:intake": "deno run -A tools/capture-intake.ts",
        // The client fetched and dated, so a claim about it can name the build it was read on.
        "game:client": "deno run -A tools/game-client-source.ts",
        // Every reading of the game this repository stands on, asked whether it is still the
        // game's — and made current again. What a work round starts with, because the gate
        // reaches no network and so cannot tell that one went behind: `frozen/AGENTS.md`.
        "game:readings": "deno run -A tools/game-readings.ts",
        // Every key the client branches on, lifted out of that bundle and frozen beside it.
        "game:keys": "deno run -A tools/protocol-key-table.ts",
        // Every skill the game publishes, and the turns each effect is stated to run for — the
        // only source that states a duration at all. `docs/statuses-standing.md` grades what the
        // recordings show against it.
        "game:skills": "deno run -A tools/skill-table.ts",
        // The published help, cached and searched, and the counts a register claim is held to.
        "game:help": "deno run -A tools/help-article.ts",
        // What a release says about itself: the version this tree declares, and the section
        // `CHANGELOG.md` carries for it. `release.yml` runs both, and so can a hand before a tag.
        "release:notes": "deno run -A tools/changelog.ts"
    },
    "fmt": {
        // 4 spaces, hard limit of 100 columns, nothing hidden by a scrollbar.
        "indentWidth": 4,
        "lineWidth": 100,
        "semiColons": true,
        "singleQuote": false,
        "useTabs": false,
        "exclude": [
            // Evidence. Formatting a recording is editing it.
            "captures/",
            // Written by tooling, including their headers. Regenerating is how they change.
            "frozen/protocol-keys.ts",
            "frozen/help-phrases.ts",
            // The maintainer's list. `.claude/settings.json` denies the three tools that edit a
            // file, and a formatter is not one of them — it rewrote this file once, which is
            // exactly the trap AGENTS.md warns about: the wall is narrower than the rule.
            "TODO.md"
        ]
    },
    "lint": {
        "rules": { "tags": ["recommended"] },
        "exclude": ["captures/"]
    },
    // `package.json` owns the one npm dependency this repository has, and npm installs it. Deno
    // reads the same `node_modules` rather than managing one of its own, which is what keeps
    // `deno check` reading the browser suite instead of skipping it — ADR 0047.
    "nodeModulesDir": "manual",
    "imports": {
        "@/": "./",
        "@std/assert": "jsr:@std/assert@^1",
        // The barrel re-exports every module, and `deno bundle` keeps the top-level
        // `new Set(…)` and `new RegExp(…)` of two it cannot prove pure: 911 dead bytes
        // measured in `dist/margometer.user.js` on 2026-09-01. What ships takes this one.
        "@std/assert/assert": "jsr:@std/assert@^1/assert",
        "@std/async": "jsr:@std/async@^1",
        "@std/cli": "jsr:@std/cli@^1",
        "@std/fs": "jsr:@std/fs@^1",
        "@std/jsonc": "jsr:@std/jsonc@^1",
        "@std/path": "jsr:@std/path@^1"
    },
    "compilerOptions": {
        "lib": ["deno.ns", "dom", "dom.iterable", "esnext"],
        "strict": true,
        // Standing in for a linter's dead-code rules: unused is a build failure, not something
        // to read past. This is what stood between v1's tree and accumulated uncalled functions.
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        // The decoder lives on indexing. Every access proves itself rather than assuming a hit.
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noImplicitReturns": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "allowUnreachableCode": false,
        "allowUnusedLabels": false
    },
    "exclude": ["captures/", "design/", "dist/", ".cache/", "node_modules/"]
}
