{
    // The version the rewrite ships as, after `develop`'s 0.19.0; a build handed none marks it `-dev`.
    "version": "0.20.0",
    "tasks": {
        // The gate. One command, so there is no version of "I ran the tests but not the lint".
        // `-A`: the recordings are read out of git by a subprocess, `tests/recorded-messages.ts`.
        //
        // ⚠️ **The bundle is checked a second time, as a browser program.** `deno.ns` below
        // carries the current TypeScript library whatever ES level stands beside it, so a
        // construct past the browser floor type-checks here and ships; `project/browser-lib.json`
        // is the reading without it. It keeps a lock of its own and runs `--frozen`: sharing
        // this one, it rewrote it down to the one package it imports (seen 2026-09-25).
        "check": "deno fmt --check && deno lint && deno check && deno check --frozen --config project/browser-lib.json src/userscript-boot.ts && deno test -A && deno task build",
        // A release passes its version; a build without one takes what this file declares, marked
        // `-dev`. `dist/` is what a release attaches, and git does not carry it.
        "build": "deno run -A tools/build-userscript.ts",
        // What a recording adds up to, per combatant, in the text `develop`'s task of this name
        // prints: with no path, every recording at `tests/recording-revision.ts`'s revision.
        "fight:figures": "deno run -A tools/fight-figures.ts",
        // `docs/design.md` §12's proof: that text against `develop`'s own, run from its own tree
        // under `.cache/`. Outside the gate because it runs another branch's program; a
        // difference exits 1 and is a finding in one of the two, never an expectation to move.
        "fight:develop": "deno run -A tools/develop-figures.ts",
        // The built file in the Chrome this machine has, on Node: outside the gate on purpose
        // (`develop ADR 0047`), and what W9 asks of a change under `src/` before it is done.
        "e2e": "npx playwright test"
    },
    "fmt": {
        // 100 columns, so nothing is hidden by a scrollbar.
        "indentWidth": 4,
        "lineWidth": 100,
        "semiColons": true,
        "singleQuote": false,
        "useTabs": false,
        "exclude": [
            // Fights nobody fought, and output nobody hand-writes.
            "fabricated/",
            "dist/",
            ".cache/",
            "node_modules/",
            // The maintainer's list. A formatter is a tool that walks the tree and writes, and
            // AGENTS.md's Never rule wants it walled off before its first run.
            "TODO.md"
        ]
    },
    "lint": {
        "rules": { "tags": ["recommended"] }
    },
    "imports": {
        "#/": "./",
        "@std/assert": "jsr:@std/assert@^1",
        // The barrel re-exports every module, and `deno bundle` keeps the top-level
        // `new Set(…)` and `new RegExp(…)` of two it cannot prove pure: 911 dead bytes
        // measured in `develop:dist/margometer.user.js` on 2026-09-01. What ships takes this one.
        "@std/assert/assert": "jsr:@std/assert@^1/assert",
        "@std/fs": "jsr:@std/fs@^1",
        "@std/jsonc": "jsr:@std/jsonc@^1",
        "@std/random": "jsr:@std/random@^0.1"
    },
    "compilerOptions": {
        "lib": ["deno.ns", "dom", "dom.iterable", "esnext"],
        "strict": true,
        // Standing in for a linter's dead-code rules: unused is a build failure, not something
        // to read past.
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        // The decoder lives on indexing. Every access proves itself rather than assuming a hit.
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noImplicitReturns": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "allowUnreachableCode": false,
        "allowUnusedLabels": false
    },
    // `.claude/` holds the worktrees Claude Code gives its subagents, each a whole copy of the tree
    // inside this one: an argument-less `deno check` walked them, and their `#/` resolved against
    // this root, so a change here reddened the gate with errors from a copy nobody was gating.
    "exclude": ["dist/", ".cache/", "fabricated/", "node_modules/", ".claude/"]
}
