{
    "tasks": {
        // The gate. One command, so there is no version of "I ran the tests but not the build".
        // `build` writes `dist/`, which git does not carry: what ships is checked as a file.
        "check": "deno fmt --check && deno lint && deno check && deno test -A && deno task build",
        // The file a reader installs. A release passes its version; a build without one says so.
        "build": "deno run -A tools/build-userscript.ts",
        // The panel in a browser, changing while you edit it: the add-on over a recording,
        // rebuilt and reloaded on a change under `src/`.
        "preview": "deno run -A tools/preview-server.ts",
        // The same panel, written down for somebody who has installed nothing: one page per
        // recording under `dist/preview`, which `.github/workflows/pages.yml` publishes.
        "preview:site": "deno run -A tools/preview-site.ts",
        // The panel photographed, one picture per state a README shows. It refuses a tree whose
        // `src/` is not in a commit, which is `DESIGN.md`'s rule and not this file's.
        "screenshots": "deno run -A tools/panel-screenshots.ts",
        // How a recording the add-on wrote becomes material: two redactions, then a file.
        "intake": "deno run -A tools/capture-intake.ts"
    },
    "fmt": {
        // 4 spaces, hard limit of 100 columns, nothing hidden by a scrollbar.
        "indentWidth": 4,
        "lineWidth": 100,
        "semiColons": true,
        "singleQuote": false,
        "useTabs": false,
        "exclude": [
            // Evidence. Formatting a recording is editing it.
            "captures/",
            // Written by tooling, including their headers. Regenerating is how they change.
            "tests/frozen-protocol-keys.ts",
            "tests/frozen-help-phrases.ts",
            // The maintainer's list. `.claude/settings.json` denies the three tools that edit a
            // file, and a formatter is not one of them — it rewrote this file once, which is
            // exactly the trap AGENTS.md warns about: the wall is narrower than the rule.
            "TODO.md"
        ]
    },
    "lint": {
        "rules": { "tags": ["recommended"] },
        "exclude": ["captures/"]
    },
    "imports": {
        "@/": "./",
        "@std/assert": "jsr:@std/assert@^1"
    },
    "compilerOptions": {
        "lib": ["deno.ns", "dom", "dom.iterable", "esnext"],
        "strict": true,
        // Standing in for a linter's dead-code rules: unused is a build failure, not something
        // to read past. This is what stood between v1's tree and accumulated uncalled functions.
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        // The decoder lives on indexing. Every access proves itself rather than assuming a hit.
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noImplicitReturns": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "allowUnreachableCode": false,
        "allowUnusedLabels": false
    },
    "exclude": ["captures/", "dist/", ".cache/", "node_modules/"]
}
