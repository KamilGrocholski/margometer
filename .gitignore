# The built userscript. A release attaches it; git does not carry it.
dist/

# Game client sources, fetched on demand. Outside git by copyright requirement.
.cache/

# What `npm ci` installs for the browser suite. `package-lock.json` is what git carries.
node_modules/

# Session machinery, not project content.
.claude/scheduled_tasks.lock

# Fights nobody fought, composed by `deno task fight:fabricate` for one machine.
# `captures/` is evidence; this is invented, and never enters git.
fabricated/
